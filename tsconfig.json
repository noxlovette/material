{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["$app/types", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
  "exclude": ["node_modules", "dist", ".svelte-kit"]
}
