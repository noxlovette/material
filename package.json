{
  "name": "@noxlovette/material",
  "version": "0.10.7",
  "description": "A Material Design 3 component library for Svelte, built on Bits UI.",
  "keywords": [
    "bits-ui",
    "component-library",
    "material-design",
    "material-you",
    "md3",
    "svelte",
    "sveltekit",
    "ui"
  ],
  "homepage": "https://material.noxlovette.com",
  "bugs": {
    "url": "https://github.com/noxlovette/material/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noxlovette/material.git"
  },
  "bin": {
    "material-claude-skill": "./bin/material-claude-skill.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "claude-skill",
    "bin"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./styles": "./dist/index.css",
    "./styles/icon-font.css": "./dist/styles/icon-font.css",
    "./theme/*": "./dist/styles/theme/*.css"
  },
  "scripts": {
    "build": "bun run generate:springs && svelte-package && bun scripts/copy-skill.ts",
    "generate:icons": "bun scripts/generate-icon-catalog.ts",
    "generate:springs": "bun scripts/generate-motion-springs.ts && oxfmt src/lib/styles/motion.css",
    "build:site": "vite build",
    "watch": "svelte-package --watch",
    "prepublishOnly": "bun run build",
    "check": "svelte-kit sync && svelte-check",
    "test": "vitest run",
    "format": "oxfmt",
    "dev": "vite dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "publint": "publint",
    "index": "bun run scripts/generate-components-index.ts"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/date": "^3.12.4",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "motion": "^14",
    "nanoid": "^6.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-svelte-csf": "5.1.5",
    "@storybook/svelte-vite": "10.6.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/package": "^3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "publint": "^0.3.25",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "storybook": "10.6.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "sveltekit-superforms": "^3",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.1",
    "@sveltejs/kit": "^2.58.0 || ^3.0.0",
    "svelte": "^5",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.2.2"
  }
}
