{
  "name": "@noxlovette/material",
  "version": "0.6.0",
  "type": "module",
  "description": "A Material Design 3 component library for Svelte, built on Bits UI.",
  "keywords": [
    "svelte",
    "sveltekit",
    "material-design",
    "material-you",
    "md3",
    "component-library",
    "bits-ui",
    "ui"
  ],
  "license": "MIT",
  "homepage": "https://material.noxlovette.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noxlovette/material.git"
  },
  "bugs": {
    "url": "https://github.com/noxlovette/material/issues"
  },
  "scripts": {
    "build": "bun run generate:springs && svelte-package && bun scripts/copy-skill.ts",
    "generate:springs": "bun scripts/generate-motion-springs.ts && prettier --write src/lib/styles/motion.css",
    "build:site": "vite build",
    "watch": "svelte-package --watch",
    "prepublishOnly": "bun run build",
    "check": "svelte-kit sync && svelte-check",
    "test": "vitest run",
    "format": "prettier --write .",
    "dev": "vite dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "publint": "publint",
    "index": "bun run scripts/generate-components-index.ts"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "claude-skill",
    "bin"
  ],
  "bin": {
    "material-claude-skill": "./bin/material-claude-skill.js"
  },
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./styles": "./dist/index.css",
    "./theme/*": "./dist/styles/theme/*.css"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.58.0",
    "@tailwindcss/typography": "^0.5.19",
    "svelte": "^5.45.6",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "@internationalized/date": "^3.12.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/svelte-vite": "10.5.10",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.24",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "storybook": "10.5.10",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6",
    "typescript-eslint": "^8.70.1",
    "vite": "8.2.2",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/date": "^3.12.4",
    "@ktibow/material-color-utilities-nightly": "^0.4.1772748028000",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "motion": "^13.4.3",
    "nanoid": "^6.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  }
}
